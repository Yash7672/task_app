<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingLeft="28dp"
    android:paddingRight="28dp">

    <TextView
        android:id="@+id/alarm_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.25"
        android:text="@string/pylo_alarm_kicker"
        android:textColor="@color/pylo_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-thin"
        android:includeFontPadding="false"
        android:textColor="@color/pylo_text_primary"
        android:textSize="116sp" />

    <TextView
        android:id="@+id/alarm_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textColor="@color/pylo_text_secondary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/alarm_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_alarm_pill"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textColor="@color/pylo_text_primary"
        android:textSize="19sp" />

    <Button
        android:id="@+id/btn_snooze"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_alarm_snooze"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.15"
        android:minWidth="180dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/pylo_alarm_snooze"
        android:textColor="@color/pylo_accent"
        android:textSize="14sp" />

    <com.example.task_app.SlideToStopView
        android:id="@+id/slide_stop"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="22dp" />
</LinearLayout>