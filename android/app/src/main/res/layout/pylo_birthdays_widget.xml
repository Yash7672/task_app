<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar-style Birthdays widget. Single TextViews per month-day keep the
     view count well under RemoteViews limits (42 cells + 7 weekday + 3 header).
     Tapping a 🎂 day or the month header opens the PYLO Birthdays screen; the
     ‹ › arrows navigate months via broadcasts to the provider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/pylo_widget_bg">

    <!-- Month header: prev arrow | title | next arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#x2039;"
            android:textColor="@color/widget_accent_color"
            android:textSize="24sp"
            android:gravity="center"
            android:contentDescription="Previous month" />

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BIRTHDAYS"
            android:textColor="@color/widget_header_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="&#x203A;"
            android:textColor="@color/widget_accent_color"
            android:textSize="24sp"
            android:gravity="center"
            android:contentDescription="Next month" />
    </LinearLayout>

    <!-- Weekday header (Sunday-first) -->
