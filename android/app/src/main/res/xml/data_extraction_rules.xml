<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_lock_enabled"/>
        <exclude domain="sharedpref" path="pin_hash"/>
        <exclude domain="sharedpref" path="pin_salt"/>
        <exclude domain="sharedpref" path="biometric_enabled"/>
        <exclude domain="sharedpref" path="lock_timeout"/>
        <exclude domain="sharedpref" path="pin_failed_attempts"/>
        <exclude domain="sharedpref" path="pin_lockout_until_ms"/>
        <exclude domain="database" path="taskflow.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_lock_enabled"/>
        <exclude domain="sharedpref" path="pin_hash"/>
        <exclude domain="sharedpref" path="pin_salt"/>
        <exclude domain="sharedpref" path="biometric_enabled"/>
        <exclude domain="sharedpref" path="lock_timeout"/>
        <exclude domain="sharedpref" path="pin_failed_attempts"/>
        <exclude domain="sharedpref" path="pin_lockout_until_ms"/>
        <exclude domain="database" path="taskflow.db"/>
    </device-transfer>
</data-extraction-rules>
